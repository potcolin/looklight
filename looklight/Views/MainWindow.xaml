<Window x:Class="looklight.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:shell="clr-namespace:looklight.Behaviors"
        prism:ViewModelLocator.AutoWireViewModel="True"
        shell:ShellBehavior.Enabled="True"
        mc:Ignorable="d"
        Title="looklight"
        Height="560" Width="760" MinHeight="380" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Topmost="{Binding IsTopMost}"
        Style="{StaticResource MaterialDesignWindow}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <WindowChrome.WindowChrome>
        <!-- 去掉系统标题栏（连带最小化/最大化/关闭按钮），但保留窗口边缘的拖拽缩放 -->
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel>
        <!-- 应用栏：兼作标题栏，空白处按住可拖动窗口 -->
        <materialDesign:ColorZone DockPanel.Dock="Top"
                                  Mode="PrimaryMid"
                                  Padding="14,4"
                                  materialDesign:ElevationAssist.Elevation="Dp3"
                                  shell:WindowBehavior.IsDragArea="True">
            <DockPanel>
                <Image Source="/Resource/colin.ico"
                       Width="20" Height="20"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            Width="32" Height="32"
                            Foreground="White"
                            ToolTip="窗口置顶（点击切换）"
                            Command="{Binding ToggleTopMostCommand}">
                        <materialDesign:PackIcon Width="18" Height="18">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="PinOutline"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTopMost}" Value="True">
                                            <Setter Property="Kind" Value="Pin"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            Width="32" Height="32"
                            Foreground="White"
                            ToolTip="设置"
                            Command="{Binding ToggleSettingsCommand}">
                        <materialDesign:PackIcon Kind="Cog" Width="18" Height="18"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            Width="32" Height="32"
                            Foreground="White"
                            ToolTip="关闭到托盘"
                            shell:WindowBehavior.IsCloseButton="True">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
                <TextBlock Text="looklight"
                           FontSize="16"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           Foreground="White"/>
            </DockPanel>
        </materialDesign:ColorZone>

        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Padding="14,6" Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="Alt+M 显示/隐藏 · 关闭窗口最小化到托盘"
                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                           Opacity="0.6"
                           Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <Grid Margin="14,12,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 输入区 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox"
                         Grid.Column="0"
                         Margin="0,0,0,16"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="输入单词、短语或句子"
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         FontSize="15"
                         IsEnabled="{Binding IsNotBusy}"
                         shell:FocusBehavior.IsBusy="{Binding IsBusy}"
                         shell:FocusBehavior.RefocusOnValidationError="True"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding QueryCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1"
                        Margin="10,0,0,0"
                        MinWidth="100"
                        Height="44"
                        VerticalAlignment="Center"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Content="{Binding QueryButtonText}"
                        Command="{Binding QueryCommand}"/>
            </Grid>

            <!-- 查询进度 -->
            <ProgressBar Grid.Row="1"
                         Height="3"
                         Margin="0,2,0,0"
                         Style="{StaticResource MaterialDesignLinearProgressBar}"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

            <!-- API Key 设置面板：Key 只存 %APPDATA%，不写进仓库里的 config.json -->
            <materialDesign:Card Grid.Row="2"
                                 Margin="0,10,0,0"
                                 Padding="14"
                                 Style="{StaticResource MaterialDesignOutlinedCard}"
                                 Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}"
                               TextWrapping="Wrap"
                               Opacity="0.75"
                               Text="API Key 只保存在本机（%APPDATA%\looklight\settings.json），不会写入仓库里的 config.json。"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox Grid.Column="0"
                                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                     materialDesign:HintAssist.Hint="API Key"
                                     shell:FocusBehavior.AutoFocus="True"
                                     shell:PasswordBoxBehavior.BoundPassword="{Binding ApiKeyInput, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}">
                            <PasswordBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SaveApiKeyCommand}"/>
                            </PasswordBox.InputBindings>
                        </PasswordBox>
                        <Button Grid.Column="1"
                                Margin="10,0,0,0"
                                Height="40"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Content="保存"
                                Command="{Binding SaveApiKeyCommand}"/>
                        <Button Grid.Column="2"
                                Margin="8,0,0,0"
                                Height="40"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Content="取消"
                                Command="{Binding ToggleSettingsCommand}"/>
                        <Button Grid.Column="3"
                                Margin="4,0,0,0"
                                Height="40"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Content="获取 Key"
                                ToolTip="在浏览器中打开 DeepSeek 平台的 API Keys 页面"
                                Command="{Binding OpenApiKeyPageCommand}"/>
                    </Grid>

                    <Separator Margin="0,14,0,2" Background="{DynamicResource MaterialDesignDivider}"/>

                    <!-- 开机自启动：写当前用户的启动项，不需要管理员权限 -->
                    <DockPanel Margin="0,8,0,0">
                        <ToggleButton DockPanel.Dock="Left"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      ToolTip="登录 Windows 后自动启动 looklight"
                                      IsChecked="{Binding IsAutoStartEnabled, Mode=TwoWay}"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="开机自启动"
                                       Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                            <TextBlock Text="启动项写在当前用户下（注册表 Run），无需管理员权限；开关状态同时记在 settings.json"
                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                       Opacity="0.6"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- 结果区（Markdown 渲染） -->
            <materialDesign:Card Grid.Row="3"
                                 Margin="0,10,0,0"
                                 Style="{StaticResource MaterialDesignElevatedCard}"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <!-- MarkdownViewer 模板内部已是 FlowDocumentScrollViewer，外面不能再套 ScrollViewer：
                         那样内层拿不到有限高度就不会滚动，却仍把滚轮事件标记为已处理。 -->
                    <md:MarkdownViewer Markdown="{Binding ResultMarkdown}"/>

                    <!-- 空状态提示：有结果后自动隐藏 -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResult}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="TextSearch"
                                                 Width="44" Height="44"
                                                 HorizontalAlignment="Center"
                                                 Opacity="0.25"/>
                        <TextBlock Text="输入单词、短语或句子后按回车"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"
                                   Opacity="0.45"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </DockPanel>
</Window>
