<prism:PrismApplication x:Class="looklight.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
             xmlns:prism="http://prismlibrary.com/">
    <Application.Resources>
        <!-- Markdig.Wpf 自带排版很稀疏（段落自动间距、标题 42px 等），覆盖它的主题样式键让结果更紧凑。 -->
        <Style x:Key="{x:Static md:Styles.DocumentStyleKey}" TargetType="{x:Type FlowDocument}">
            <Setter Property="FlowDocument.FontFamily" Value="Calibri, Microsoft YaHei UI" />
            <Setter Property="FlowDocument.FontSize" Value="13" />
            <Setter Property="FlowDocument.LineHeight" Value="17" />
            <Setter Property="FlowDocument.LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="FlowDocument.TextAlignment" Value="Left" />
            <Setter Property="FlowDocument.PagePadding" Value="8,4,4,4" />
        </Style>

        <Style x:Key="{x:Static md:Styles.ParagraphStyleKey}" TargetType="{x:Type Paragraph}">
            <Setter Property="Block.Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="{x:Static md:Styles.Heading1StyleKey}" TargetType="{x:Type Paragraph}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FF111111" />
            <Setter Property="Block.Margin" Value="0,6,0,3" />
        </Style>
        <Style x:Key="{x:Static md:Styles.Heading2StyleKey}" TargetType="{x:Type Paragraph}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FF111111" />
            <Setter Property="Block.Margin" Value="0,5,0,2" />
        </Style>
        <Style x:Key="{x:Static md:Styles.Heading3StyleKey}" TargetType="{x:Type Paragraph}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FF111111" />
            <Setter Property="Block.Margin" Value="0,4,0,2" />
        </Style>
        <Style x:Key="{x:Static md:Styles.Heading4StyleKey}" TargetType="{x:Type Paragraph}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FF111111" />
            <Setter Property="Block.Margin" Value="0,3,0,1" />
        </Style>
        <Style x:Key="{x:Static md:Styles.Heading5StyleKey}" TargetType="{x:Type Paragraph}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Block.Margin" Value="0,3,0,1" />
        </Style>
        <Style x:Key="{x:Static md:Styles.Heading6StyleKey}" TargetType="{x:Type Paragraph}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Block.Margin" Value="0,3,0,1" />
        </Style>

        <Style TargetType="{x:Type List}">
            <Setter Property="Block.Margin" Value="16,0,0,2" />
            <Setter Property="Block.Padding" Value="0" />
        </Style>

        <Style x:Key="{x:Static md:Styles.QuoteBlockStyleKey}" TargetType="{x:Type Section}">
            <Setter Property="Block.BorderBrush" Value="#FFD3D3D3" />
            <Setter Property="Block.BorderThickness" Value="3,0,0,0" />
            <Setter Property="Block.Padding" Value="8,0,0,0" />
            <Setter Property="Foreground" Value="#FF606060" />
        </Style>

        <Style x:Key="{x:Static md:Styles.CodeBlockStyleKey}" TargetType="{x:Type Paragraph}">
            <Setter Property="Background" Value="#FFF2F2F2" />
            <Setter Property="FontFamily" Value="Consolas, Lucida Sans Typewriter, Courier New" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Block.Margin" Value="0,2,0,2" />
            <Setter Property="Block.Padding" Value="4,2,4,2" />
        </Style>
        <Style x:Key="{x:Static md:Styles.CodeStyleKey}" TargetType="{x:Type Run}">
            <Setter Property="Background" Value="#FFF2F2F2" />
            <Setter Property="FontFamily" Value="Consolas, Lucida Sans Typewriter, Courier New" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="{x:Static md:Styles.TableStyleKey}" TargetType="{x:Type Table}">
            <Setter Property="Block.BorderBrush" Value="#FFBBBBBB" />
            <Setter Property="Block.BorderThickness" Value="0,0,1,1" />
            <Setter Property="Block.Margin" Value="0,2,0,2" />
            <Setter Property="Table.CellSpacing" Value="0" />
        </Style>
        <Style x:Key="{x:Static md:Styles.TableCellStyleKey}" TargetType="{x:Type TableCell}">
            <Setter Property="TableCell.BorderBrush" Value="#FFBBBBBB" />
            <Setter Property="TableCell.BorderThickness" Value="1,1,0,0" />
            <Setter Property="TableCell.Padding" Value="4,1,4,1" />
        </Style>
        <Style x:Key="{x:Static md:Styles.TableHeaderStyleKey}" TargetType="{x:Type TableRow}">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="{x:Static md:Styles.ThematicBreakStyleKey}" TargetType="{x:Type Line}">
            <Setter Property="Shape.Stretch" Value="Fill" />
            <Setter Property="Stroke" Value="#FFDDDDDD" />
            <Setter Property="Block.Margin" Value="0,4,0,4" />
        </Style>
    </Application.Resources>
</prism:PrismApplication>
